      <column caption='Unhealthy' datatype='integer' name='[Calculation_0601758911586305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status]=&quot;unhealthy&quot; THEN 10 ELSE 0 END' />
      </column>
      <column caption='Total Downtime Display' datatype='string' name='[Calculation_0601758920826882]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(INT(SUM([Calculation_0601758911586305]) / 60))&#13;&#10;+ &quot;h &quot;&#13;&#10;+ STR(INT(SUM([Calculation_0601758911586305]) - INT(SUM([Calculation_0601758911586305]) / 60) * 60))&#13;&#10;+ &quot;m&quot;' />
      </column>
      <column caption='Downtime Events' datatype='integer' name='[Calculation_0601758921252867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status]=&quot;unhealthy&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Factory Display Name' datatype='string' name='[Calculation_0601758936973316]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [factory]&#13;&#10;WHEN &quot;daikibo-berlin&quot; THEN &quot;Berlin&quot;&#13;&#10;WHEN &quot;daikibo-factory-meiyo&quot; THEN &quot;Meiyo&quot;&#13;&#10;WHEN &quot;daikibo-factory-seiko&quot; THEN &quot;Seiko&quot;&#13;&#10;WHEN &quot;daikibo-shenzhen&quot; THEN &quot;Shenzhen&quot;&#13;&#10;END' />
      </column>
      <column caption='Device Type Display Name' datatype='string' name='[Calculation_0601758943678469]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [deviceType]&#13;&#10;WHEN &quot;LaserWelder&quot; THEN &quot;Laser Welder&quot;&#13;&#10;WHEN &quot;LaserCutter&quot; THEN &quot;Laser Cutter&quot;&#13;&#10;WHEN &quot;HeavyDutyDrill&quot; THEN &quot;Heavy Duty Drill&quot;&#13;&#10;WHEN &quot;ConveyorBelt&quot; THEN &quot;Conveyor Belt&quot;&#13;&#10;WHEN &quot;SpotWelder&quot; THEN &quot;Spot Welder&quot;&#13;&#10;WHEN &quot;AirWrench&quot; THEN &quot;Air Wrench&quot;&#13;&#10;WHEN &quot;MetalPress&quot; THEN &quot;Metal Press&quot;&#13;&#10;WHEN &quot;Furnace&quot; THEN &quot;Furnace&quot;&#13;&#10;WHEN &quot;CNC&quot; THEN &quot;CNC&quot;&#13;&#10;END' />
      </column>
      <column caption='Machine Types with Downtime' datatype='string' name='[Calculation_0601758952443910]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0601758911586305] &gt; 0 THEN [deviceType] END' />
      </column>
